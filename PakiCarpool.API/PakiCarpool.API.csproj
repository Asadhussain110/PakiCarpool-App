<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>PakiCarpool.API</RootNamespace>
    <AssemblyName>PakiCarpool.API</AssemblyName>
    <UserSecretsId>pakicarpool-api-secrets</UserSecretsId>
  </PropertyGroup>

  <!-- Project References -->
  <ItemGroup>
    <ProjectReference Include="..\PakiCarpool.Common\PakiCarpool.Common.csproj" />
    <ProjectReference Include="..\PakiCarpool.Domain\PakiCarpool.Domain.csproj" />
    <ProjectReference Include="..\PakiCarpool.Interfaces\PakiCarpool.Interfaces.csproj" />
    <ProjectReference Include="..\PakiCarpool.Repository\PakiCarpool.Repository.csproj" />
    <ProjectReference Include="..\PakiCarpool.Security\PakiCarpool.Security.csproj" />
    <ProjectReference Include="..\PakiCarpool.Services\PakiCarpool.Services.csproj" />
  </ItemGroup>

  <!-- NuGet Packages -->
  <ItemGroup>
    <PackageReference Include="DotNetEnv" Version="3.2.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.10" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.StackExchangeRedis" Version="10.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="10.0.10" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="8.1.1" />
    <!--
      Explicit pin: Swashbuckle pulls Microsoft.EntityFrameworkCore.Relational 10.0.4 transitively,
      which conflicts with PakiCarpool.Repository's 10.0.10. Pinning here makes 10.0.10 the
      "primary" reference and eliminates MSB3277 warning.
    -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.10" />
  </ItemGroup>

</Project>
