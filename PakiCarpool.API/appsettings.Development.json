{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information"
    }
  },
  "Swagger": {
    "Enable": true
  },
  "Liveness": {
    "NonceTtlMinutes": 10
  },
  "RateLimit": {
    "Liveness": {
      "Limit": 5,
      "Period": "1h"
    }
  }
}