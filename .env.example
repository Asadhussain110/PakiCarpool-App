# Copy to .env and replace every placeholder with local development values.
DB_CONNECTION_STRING=Host=your-project.supabase.co;Port=5432;Database=postgres;Username=postgres;Password=CHANGE_ME;SSL Mode=Require;Trust Server Certificate=true
JWT_SECRET=CHANGE_ME_WITH_AT_LEAST_32_RANDOM_UTF8_BYTES
JWT_ISSUER=CHANGE_ME_ISSUER
JWT_AUDIENCE=CHANGE_ME_AUDIENCE
AES_ENCRYPTION_KEY=CHANGE_ME_BASE64_ENCODED_32_BYTE_KEY
AES_KEY_V1=
AES_KEY_V2=
SMTP_HOST=CHANGE_ME_SMTP_HOST
SMTP_PORT=SET_SMTP_PORT
SMTP_USER=CHANGE_ME_SMTP_USER
SMTP_PASS=CHANGE_ME_SMTP_PASSWORD
SMTP_FROM=CHANGE_ME_SENDER_EMAIL
GOOGLE_CLIENT_ID=CHANGE_ME_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=CHANGE_ME_GOOGLE_CLIENT_SECRET
APP_DOMAIN=CHANGE_ME_APP_DOMAIN
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=CHANGE_ME_SUPABASE_KEY
ADMIN_SEED_TOKEN=CHANGE_ME_ADMIN_SEED_TOKEN
HCAPTCHA_SECRET=CHANGE_ME_HCAPTCHA_SECRET
# Optional in Development; required outside Development.
REDIS_CONNECTION_STRING=SET_REDIS_HOST:6379
