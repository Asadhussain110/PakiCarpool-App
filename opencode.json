
{
  "$schema": "https://opencode.ai/config.json",
  "model": "numes/z-ai/glm-5.3:free",
  "providers": {
    "numes": {
      "name": "Numes",
      "package": "@opencode/ai/providers/openrouter",
      "settings": {
        "baseURL": "https://api.numes.ai/api/v1",
        "apiKey": "{env:NUMES_API_KEY}"
      },
      "models": {
        "z-ai/glm-5.3:free": {
          "name": "GLM 5.3 (free)",
          "capabilities": {
            "tools": true,
            "temperature": true,
            "input": ["text", "image"],
            "output": ["text"]
          },
          "limit": {
            "context": 1048576,
            "output": 65536
          }
        },
        "moonshotai/kimi-k3.1-pro:free": {
          "name": "Kimi K3.1 Pro (free)",
          "capabilities": {
            "tools": true,
            "temperature": true,
            "input": ["text", "image"],
            "output": ["text"]
          },
          "limit": {
            "context": 1048576,
            "output": 65536
          }
        },
        "deepseek/deepseek-v4.1-flash:free": {
          "name": "DeepSeek V4.1 Flash (free)",
          "capabilities": {
            "tools": true,
            "temperature": true,
            "input": ["text"],
            "output": ["text"]
          },
          "limit": {
            "context": 1048576,
            "output": 65536
          }
        }
      }
    }
  }
}
